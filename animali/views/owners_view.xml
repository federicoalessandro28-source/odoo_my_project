<odoo>
    <record id="view_owner_form" model="ir.ui.view">
        <field name="name">gestione.owners.form</field>
        <field name="model">gestione.owners</field>
        <field name="arch" type="xml">
            <form string="Proprietario">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="eta'"/>
                    </group>
                    <notebook>
                        <page string="Animali Posseduti">
                            <field name="animal_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="specie"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gestione_owner" model="ir.action.act_window">
        <field name="name">Proprietario</field>
        <field name="res_model">gestione.owners</field>
        <field name="view_mode">list, form</field>
    </record>
</odoo>